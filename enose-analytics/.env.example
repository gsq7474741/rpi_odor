# enose-analytics 环境变量配置
# 复制此文件为 .env.local 并填入实际值

# gRPC 服务配置
GRPC_HOST=0.0.0.0
GRPC_PORT=50052

# enose-control gRPC 连接 (用于推送通知)
CONTROL_SERVICE_HOST=192.168.1.235
CONTROL_SERVICE_PORT=50051

# 数据库配置
DATABASE_HOST=192.168.1.235
DATABASE_PORT=5432
DATABASE_NAME=enose
DATABASE_USER=enose
DATABASE_PASSWORD=enose_secure_password_change_me

# Redis 配置 (帧缓存)
REDIS_HOST=192.168.1.235
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO 配置
MINIO_ENDPOINT=192.168.1.235:9000
